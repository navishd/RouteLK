<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".RouteLKApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RouteLK">

        <!-- Launcher: Onboarding -->
        <activity
            android:name=".activities.OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- User Flow -->
        <activity
            android:name=".activities.Home"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.BusListScreen"
            android:exported="false" />
        <activity
            android:name=".activities.BusDetails"
            android:exported="false" />
        <activity
            android:name=".activities.SeatSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".activities.PassengerDetailsScreen"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.Payment"
            android:exported="false" />
        <activity
            android:name=".activities.TicketViewActivity"
            android:exported="false" />
        <activity
            android:name=".activities.BookingSuccess"
            android:exported="false" />
        <activity
            android:name=".activities.MyBookingsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.MyActivitiesActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ManageBookingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Other User Features -->
        <activity
            android:name=".activities.NotificationsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".activities.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.ChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.HelpSupportActivity"
            android:exported="false" />

        <!-- Admin Panel -->
        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ManageBusesActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ManageRoutesActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ManageUsersActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ViewBookingsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ReportsActivity"
            android:exported="false" />

    </application>

</manifest>