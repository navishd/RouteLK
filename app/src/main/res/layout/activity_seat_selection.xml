                <Space android:layout_width="60dp"/>

                <Button android:id="@+id/seat39" android:text="39" style="@style/SeatButton"/>
                <Button android:id="@+id/seat40" android:text="40" style="@style/SeatButton"/>

            </TableRow>


            <TableRow>

                <Button android:id="@+id/seat41" android:text="41" style="@style/SeatButton"/>
