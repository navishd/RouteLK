            </TableRow>


            <TableRow>

                <Button android:id="@+id/seat25" android:text="25" style="@style/SeatButton"/>
                <Button android:id="@+id/seat26" android:text="26" style="@style/SeatButton"/>

                <Space android:layout_width="60dp"/>

                <Button android:id="@+id/seat27" android:text="27" style="@style/SeatButton"/>
                <Button android:id="@+id/seat28" android:text="28" style="@style/SeatButton"/>

            </TableRow>


            <TableRow>

                <Button android:id="@+id/seat29" android:text="29" style="@style/SeatButton"/>
