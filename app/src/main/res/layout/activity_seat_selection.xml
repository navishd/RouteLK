<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/seatSelectionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Your Seat"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="25dp"/>



        <TableLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">


            <!-- Seat Rows -->

            <TableRow>

                <Button android:id="@+id/seat1" android:text="1" style="@style/SeatButton"/>
                <Button android:id="@+id/seat2" android:text="2" style="@style/SeatButton"/>

                <Space android:layout_width="60dp"/>

                <Button android:id="@+id/seat3" android:text="3" style="@style/SeatButton"/>
                <Button android:id="@+id/seat4" android:text="4" style="@style/SeatButton"/>

            </TableRow>


            <TableRow>

                <Button android:id="@+id/seat5" android:text="5" style="@style/SeatButton"/>
                <Button android:id="@+id/seat6" android:text="6" style="@style/SeatButton"/>

                <Space android:layout_width="60dp"/>

                <Button android:id="@+id/seat7" android:text="7" style="@style/SeatButton"/>
                <Button android:id="@+id/seat8" android:text="8" style="@style/SeatButton"/>

            </TableRow>


            <TableRow>

                <Button android:id="@+id/seat9" android:text="9" style="@style/SeatButton"/>
                <Button android:id="@+id/seat10" android:text="10" style="@style/SeatButton"/>

                <Space android:layout_width="60dp"/>

                <Button android:id="@+id/seat11" android:text="11" style="@style/SeatButton"/>
                <Button android:id="@+id/seat12" android:text="12" style="@style/SeatButton"/>

            </TableRow>


            <TableRow>

                <Button android:id="@+id/seat13" android:text="13" style="@style/SeatButton"/>
                <Button android:id="@+id/seat14" android:text="14" style="@style/SeatButton"/>

                <Space android:layout_width="60dp"/>

                <Button android:id="@+id/seat15" android:text="15" style="@style/SeatButton"/>
                <Button android:id="@+id/seat16" android:text="16" style="@style/SeatButton"/>

            </TableRow>


            <TableRow>

                <Button android:id="@+id/seat17" android:text="17" style="@style/SeatButton"/>
                <Button android:id="@+id/seat18" android:text="18" style="@style/SeatButton"/>

                <Space android:layout_width="60dp"/>

                <Button android:id="@+id/seat19" android:text="19" style="@style/SeatButton"/>
                <Button android:id="@+id/seat20" android:text="20" style="@style/SeatButton"/>

            </TableRow>


            <TableRow>

                <Button android:id="@+id/seat21" android:text="21" style="@style/SeatButton"/>
                <Button android:id="@+id/seat22" android:text="22" style="@style/SeatButton"/>

                <Space android:layout_width="60dp"/>

                <Button android:id="@+id/seat23" android:text="23" style="@style/SeatButton"/>
