<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".activities.SearchBusActivity">

    <!-- Title -->

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search Bus"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="60dp"
        android:layout_marginStart="24dp"/>

    <!-- From -->

    <EditText
        android:id="@+id/fromEditText"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="From"
        android:background="@drawable/edittext_bg"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

    <!-- To -->

    <EditText
        android:id="@+id/toEditText"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="To"
        android:background="@drawable/edittext_bg"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/fromEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

    <!-- Date -->

    <EditText
        android:id="@+id/dateEditText"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="Travel Date"
        android:background="@drawable/edittext_bg"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/toEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

    <!-- Passenger Count -->

    <EditText
        android:id="@+id/passengerEditText"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="Passengers"
        android:background="@drawable/edittext_bg"
        android:padding="16dp"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/dateEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

    <!-- Search Button -->

    <Button
        android:id="@+id/searchButton"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Search Buses"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2563EB"
        app:layout_constraintTop_toBottomOf="@id/passengerEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>